<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
	<LangVersion>latest</LangVersion>
	<ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<Version>11.0.0</Version>
    <AssemblyVersion>11.0.0.0</AssemblyVersion>
    <FileVersion>11.0.0.0</FileVersion>
    <Company>Orbital7</Company>
    <Copyright>Copyright © 2012-2026 Orbital7</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>.NET Extensions/Utilities</Description>
    <Authors>Josh van Eikeren</Authors>
    <PackageProjectUrl>https://github.com/orbital7/orbital7.extensions</PackageProjectUrl>
    <PackageIconUrl></PackageIconUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Orbital7.png</PackageIcon>
	<PackageReadmeFile>Readme.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/orbital7/orbital7.extensions</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\bin\release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\bin\debug\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="CSharpVitamins.ShortGuid" Version="2.0.0" />
	<PackageReference Include="CsvHelper" Version="34.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
	<PackageReference Include="NewId" Version="4.0.1" />
	<PackageReference Include="Polly" Version="8.9.1" />
	<PackageReference Include="Sqids" Version="3.2.1" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="TimeZoneConverter" Version="8.0.1" />
  </ItemGroup>
	
  <ItemGroup>
    <None Include="../../Orbital7.png">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
	<None Include="Readme.md">
      <Pack>True</Pack>
	  <PackagePath>/</PackagePath>
	</None>
	<None Include="Licenses\THIRD-PARTY-NOTICES.md">
      <Pack>True</Pack>
	  <PackagePath>licenses\</PackagePath>
	</None>
  </ItemGroup>

</Project>
